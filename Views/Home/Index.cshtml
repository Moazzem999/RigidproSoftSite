<!-- ==========================================================================
     8. CUSTOM CONTACT SECTION & FORM
     ========================================================================== -->
<section class="contact-section" id="contact">
    <div class="container">
        <!-- Section Header -->
        <div class="text-center mb-5">
            <span class="section-eyebrow">GET IN TOUCH</span>
            <h2 class="section-title">Let's Discuss Your Project</h2>
            <p class="section-subtitle mx-auto">
                Ready to take your digital presence to the next level? Fill out the form below, and our team will get back to you within 24 hours.
            </p>
        </div>

        <div class="row g-5">
            <!-- Contact Info Sidebar -->
            <div class="col-lg-4">
                <div class="contact-info-card">
                    <h3 class="fw-bold fs-4 mb-4">Contact Information</h3>
                    
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div class="contact-item-text">
                            <h6>Call Us Directly</h6>
                            <p>+880 1234 567890</p>
                            <small class="text-muted">Sun - Thu, 9am - 6pm BST</small>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div class="contact-item-text">
                            <h6>Email Inquiries</h6>
                            <p>info@rigidprosoft.com</p>
                            <small class="text-muted">24/7 online response</small>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div class="contact-item-text">
                            <h6>Headquarters</h6>
                            <p>Gulshan-2, Dhaka, Bangladesh</p>
                            <small class="text-muted">Innovation Hub Center</small>
                        </div>
                    </div>

                    <hr class="my-4 border-secondary border-opacity-25" />

                    <div class="p-3 bg-white rounded-3 border">
                        <div class="d-flex align-items-center gap-2 text-primary fw-semibold mb-1">
                            <i class="bi bi-clock-history"></i> Fast Response SLA
                        </div>
                        <small class="text-muted">
                            Every message is reviewed by our lead architect within 24 hours with an initial project feasibility scope.
                        </small>
                    </div>
                </div>
            </div>

            <!-- Custom Contact Form -->
            <div class="col-lg-8">
                <div class="contact-form-card">
                    <h3 class="fw-bold fs-4 mb-3">Send Us a Message</h3>
                    <p class="text-muted mb-4">Tell us about your project goals, timelines, and requirements.</p>

                    <form id="contactForm" novalidate>
                        <div class="row g-3">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label for="contactName" class="form-label-custom">Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-custom" id="contactName" placeholder="e.g. John Doe" required />
                            </div>

                            <!-- Email Address -->
                            <div class="col-md-6">
                                <label for="contactEmail" class="form-label-custom">Work Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control form-control-custom" id="contactEmail" placeholder="e.g. john@company.com" required />
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <label for="contactPhone" class="form-label-custom">Phone Number (Optional)</label>
