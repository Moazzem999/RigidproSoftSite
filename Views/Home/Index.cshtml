@{
    ViewData["Title"] = "RIGIDPRO SOFT - Innovative Digital Solutions";
}

<!-- ==========================================================================
     1. HERO SECTION
     ========================================================================== -->
<section class="hero-section" id="hero">
    <div class="container position-relative">
        <div class="row align-items-center g-5">
            <!-- Left Column: Copy & CTAs -->
            <div class="col-lg-6">
                <div class="hero-badge">
                    <i class="bi bi-stars"></i>
                    <span>Innovative Solutions for a Smarter Tomorrow</span>
                </div>
                
                <h1 class="hero-title">
                    We Build Digital Solutions That<br />
                    <span class="gradient-text">Drive Your Business</span>
                </h1>

                <p class="hero-subtitle">
                    We are a software development company focused on creating scalable, innovative, and user-friendly solutions for businesses of all sizes.
                </p>

                <div class="hero-actions">
                    <a href="#projects" class="btn btn-primary-custom">
                        View Our Projects <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a href="#contact" class="btn btn-outline-custom">
                        Contact Us
                    </a>
                </div>

                <!-- Stats Row -->
                <div class="hero-stats">
                    <div class="stat-item">
                        <h3 class="counter-val" data-target="50">50+</h3>
                        <p>Projects Delivered</p>
                    </div>
                    <div class="stat-item">
                        <h3 class="counter-val" data-target="30">30+</h3>
                        <p>Happy Clients</p>
                    </div>
                    <div class="stat-item">
                        <h3 class="counter-val" data-target="5">5+</h3>
                        <p>Years of Experience</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Visual Laptop Mockup -->
            <div class="col-lg-6">
                <div class="hero-visual-container">
                    <!-- Floating Top Badge -->
                    <div class="floating-badge badge-top">
                        <div class="badge-icon bg-success-glow">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="badge-text">
                            <h6>100% Delivery Rate</h6>
                            <span>On-Time & On-Budget</span>
                        </div>
                    </div>

                    <!-- Laptop Workstation Image -->
                    <div class="hero-img-wrapper">
                        <img src="~/images/hero_laptop.jpg" alt="Developer coding at workstation - RIGIDPRO SOFT" class="hero-main-img" />
                    </div>

                    <!-- Floating Bottom Badge -->
                    <div class="floating-badge badge-bottom">
                        <div class="badge-icon bg-primary-glow">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <div class="badge-text">
                            <h6>High Performance</h6>
                            <span>Cloud Native Architecture</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     2. WHAT WE DO / OUR SERVICES SECTION
     ========================================================================== -->
<section class="services-section" id="services">
    <div class="container">
        <!-- Section Header -->
        <div class="text-center mb-5">
            <span class="section-eyebrow">WHAT WE DO</span>
            <h2 class="section-title">Our Services</h2>
            <p class="section-subtitle mx-auto">
                We offer a wide range of software development and IT consulting services to help you build, grow, and succeed in the digital world.
            </p>
        </div>

        <!-- 6 Service Cards (3x2 Grid) -->
        <div class="row g-4">
            <!-- 1. Web Application Development -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon-box">
                        <i class="bi bi-code-slash"></i>
                    </div>
                    <h3 class="service-title">Web Application Development</h3>
                    <p class="service-desc">
                        Modern, scalable, and high-performance web applications using the latest technologies.
                    </p>
                </div>
            </div>

            <!-- 2. Mobile App Development -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon-box">
                        <i class="bi bi-phone"></i>
                    </div>
                    <h3 class="service-title">Mobile App Development</h3>
                    <p class="service-desc">
                        Native and cross-platform mobile apps for Android and iOS.
                    </p>
                </div>
            </div>

            <!-- 3. Cloud Solutions -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon-box">
                        <i class="bi bi-cloud"></i>
                    </div>
                    <h3 class="service-title">Cloud Solutions</h3>
                    <p class="service-desc">
                        Secure, flexible, and cost-effective cloud solutions for your business.
                    </p>
                </div>
            </div>

            <!-- 4. UI/UX Design -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon-box">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <h3 class="service-title">UI/UX Design</h3>
                    <p class="service-desc">
                        User-centered design that creates meaningful and engaging experiences.
                    </p>
                </div>
            </div>

            <!-- 5. API Integration -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon-box">
                        <i class="bi bi-gear-wide-connected"></i>
                    </div>
                    <h3 class="service-title">API Integration</h3>
                    <p class="service-desc">
                        Seamless integration with third-party services and custom APIs.
                    </p>
                </div>
            </div>

            <!-- 6. IT Consulting -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon-box">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3 class="service-title">IT Consulting</h3>
                    <p class="service-desc">
                        Strategic technology consulting to help you achieve your goals.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     3. FEATURED PROJECTS SECTION
     ========================================================================== -->
<section class="projects-section" id="projects">
