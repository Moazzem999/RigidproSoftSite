        </div>

        <!-- Filter Buttons -->
        <div class="filter-btn-group">
            <button type="button" class="filter-btn active" data-filter="all">All Projects</button>
            <button type="button" class="filter-btn" data-filter="web">Web Development</button>
            <button type="button" class="filter-btn" data-filter="mobile">Mobile Apps</button>
            <button type="button" class="filter-btn" data-filter="erp">ERP & Systems</button>
