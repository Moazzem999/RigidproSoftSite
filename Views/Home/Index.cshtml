        <!-- 3 Project Cards matching mockup -->
        <div class="row g-4" id="projectCardsContainer">
            <!-- Project 1: E-Commerce Platform -->
            <div class="col-lg-4 col-md-6 project-item" data-category="web" data-id="1">
                <div class="project-card">
                    <div class="project-img-wrapper">
                        <img src="~/images/project_ecommerce.jpg" alt="E-Commerce Platform" class="project-img" />
                        <div class="project-overlay">
                            <span class="btn btn-sm btn-light rounded-pill px-3 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-eye-fill me-1"></i> Quick View
                            </span>
                        </div>
                    </div>
                    <div class="project-card-body">
                        <h3 class="project-title">E-Commerce Platform</h3>
                        <p class="project-desc">
                            A full-featured e-commerce solution with secure payments, inventory management, and admin dashboard.
                        </p>
                        <div class="project-tags">
                            <span class="project-tag">Web Development</span>
                            <span class="project-tag">E-Commerce</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project 2: Fitness Mobile App -->
            <div class="col-lg-4 col-md-6 project-item" data-category="mobile" data-id="2">
                <div class="project-card">
                    <div class="project-img-wrapper">
                        <img src="~/images/project_fitness.jpg" alt="Fitness Mobile App" class="project-img" />
                        <div class="project-overlay">
                            <span class="btn btn-sm btn-light rounded-pill px-3 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-eye-fill me-1"></i> Quick View
                            </span>
                        </div>
                    </div>
                    <div class="project-card-body">
                        <h3 class="project-title">Fitness Mobile App</h3>
                        <p class="project-desc">
                            A cross-platform fitness app with workout plans, progress tracking, and personalized recommendations.
                        </p>
                        <div class="project-tags">
                            <span class="project-tag">Mobile App</span>
                            <span class="project-tag">Health & Fitness</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project 3: Business Management System -->
            <div class="col-lg-4 col-md-6 project-item" data-category="erp" data-id="3">
                <div class="project-card">
                    <div class="project-img-wrapper">
                        <img src="~/images/project_erp.jpg" alt="Business Management System" class="project-img" />
                        <div class="project-overlay">
                            <span class="btn btn-sm btn-light rounded-pill px-3 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-eye-fill me-1"></i> Quick View
                            </span>
                        </div>
                    </div>
                    <div class="project-card-body">
                        <h3 class="project-title">Business Management System</h3>
                        <p class="project-desc">
                            A complete ERP solution to manage sales, accounting, HR, and inventory.
                        </p>
                        <div class="project-tags">
                            <span class="project-tag">Web Development</span>
                            <span class="project-tag">ERP</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

